    '?queryTimeout=' + props.getProperty('query_timeout_sec', '0') + '&amp;connectionTimeout=' + props.getProperty('connect_timeout_ms', '0')
// one connection per virtual user, opened lazily (so a ramp opens connections gradually) and replaced after any failure
def getConn = {
  def c = vars.getObject('conn')
  if (c == null || c.isClosed()) {
    c = DriverManager.getConnection(jdbcUrl); vars.putObject('conn', c)
    def reg = props.get('gg9.conns')
    if (reg == null) { props.putIfAbsent('gg9.conns', new java.util.concurrent.ConcurrentLinkedQueue()); reg = props.get('gg9.conns') }
    reg.add(c)
  }
  return c
}
def discardConn = { def c = vars.getObject('conn'); vars.putObject('conn', null); try { c?.close() } catch (Throwable ignored) { }
  try { props.get('gg9.conns')?.remove(c) } catch (Throwable ignored) { } }
def release = { c -&gt; }
try {
def c = getConn()
def ps = c.prepareStatement('''UPDATE accounts SET balance = balance + ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?''')
try {
    ps.setInt(1, Integer.parseInt(vars.get('delta')))
    ps.setLong(2, Long.parseLong(vars.get('k')))
    int n = ps.executeUpdate()
    return 'rows ' + n
} finally { ps.close() }

} catch (Throwable t) {
  discardConn()
  throw t
}
</stringProp></JSR223Sampler><hashTree></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="oltp.insert" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">

import java.sql.*
def jdbcUrl = props.getProperty('jdbc_url', 'jdbc:ignite:thin://localhost:10800,localhost:10801,localhost:10802') +
    '?queryTimeout=' + props.getProperty('query_timeout_sec', '0') + '&amp;connectionTimeout=' + props.getProperty('connect_timeout_ms', '0')
// one connection per virtual user, opened lazily (so a ramp opens connections gradually) and replaced after any failure
def getConn = {
  def c = vars.getObject('conn')
  if (c == null || c.isClosed()) {
    c = DriverManager.getConnection(jdbcUrl); vars.putObject('conn', c)
    def reg = props.get('gg9.conns')
    if (reg == null) { props.putIfAbsent('gg9.conns', new java.util.concurrent.ConcurrentLinkedQueue()); reg = props.get('gg9.conns') }
    reg.add(c)
  }
  return c
}
def discardConn = { def c = vars.getObject('conn'); vars.putObject('conn', null); try { c?.close() } catch (Throwable ignored) { }
  try { props.get('gg9.conns')?.remove(c) } catch (Throwable ignored) { } }
def release = { c -&gt; }
try {
def c = getConn()
def ps = c.prepareStatement('''INSERT INTO accounts (id, customer_id, balance, status, region, payload, updated_at) VALUES (?, ?, 0, 'ACTIVE', 'EU', ?, CURRENT_TIMESTAMP)''')
try {
    ps.setLong(1, Long.parseLong(vars.get('newId')))
    ps.setInt(2, Integer.parseInt(vars.get('newCust')))
    ps.setString(3, vars.get('payload'))
    int n = ps.executeUpdate()
    return 'rows ' + n
} finally { ps.close() }

} catch (Throwable t) {
  discardConn()
  throw t
}
