<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="GG9 run oltp (per-thread connections)" enabled="true"><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.serialize_threadgroups">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"></collectionProp></elementProp></TestPlan><hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="workload" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">-1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(threads,32)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(rampup,60)}</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${__P(duration,600)}</stringProp><stringProp name="ThreadGroup.delay">${__P(startup_delay,0)}</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></ThreadGroup><hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="pick-op" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def rnd = ThreadLocalRandom.current()
def gp = { String k, String d -&gt; props.getProperty(k, d) }
long rows = Long.parseLong(gp('oltp_rows', '1000000'))
double skew = Double.parseDouble(gp('key_skew', '1.0'))      // 1 = uniform, &gt;1 = hot-spot
int[] w = [gp('mix_read','60'), gp('mix_update','15'), gp('mix_insert','5'),
           gp('mix_range','10'), gp('mix_tx','10')].collect { Integer.parseInt(it) } as int[]
int roll = rnd.nextInt((int) w.sum()); int op = 0; int acc = 0
for (int i = 0; i &lt; w.length; i++) { acc += w[i]; if (roll &lt; acc) { op = i; break } }
def key = { 1L + (long) (rows * Math.pow(rnd.nextDouble(), skew)) }
long seq = (vars.getObject('seq') ?: 0L) + 1L
vars.putObject('seq', seq)
long salt = Long.parseLong(gp('run_salt', '0'))
vars.put('op', String.valueOf(op))
vars.put('k', String.valueOf(key()))
vars.put('k2', String.valueOf(key()))
vars.put('cust', String.valueOf(1 + rnd.nextInt((int) Math.max(1L, rows.intdiv(10L)))))
vars.put('delta', String.valueOf(1 + rnd.nextInt(100)))
vars.put('newId', String.valueOf(rows + ((salt * 10000L + ctx.getThreadNum()) * 1000000L) + seq))
vars.put('newCust', String.valueOf(1 + rnd.nextInt((int) Math.max(1L, rows.intdiv(10L)))))
vars.put('payload', 'p' + Long.toHexString(rnd.nextLong()) + Long.toHexString(rnd.nextLong()))
SampleResult.setIgnore()
return 'op=' + op
</stringProp></JSR223Sampler><hashTree></hashTree><SwitchController guiclass="SwitchControllerGui" testclass="SwitchController" testname="op-mix" enabled="true"><stringProp name="SwitchController.value">${op}</stringProp></SwitchController><hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="oltp.read" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">

import java.sql.*
def jdbcUrl = props.getProperty('jdbc_url', 'jdbc:ignite:thin://localhost:10800,localhost:10801,localhost:10802') +
    '?queryTimeout=' + props.getProperty('query_timeout_sec', '0') + '&amp;connectionTimeout=' + props.getProperty('connect_timeout_ms', '0')
// one connection per virtual user, opened lazily (so a ramp opens connections gradually) and replaced after any failure
def getConn = {
  def c = vars.getObject('conn')
  if (c == null || c.isClosed()) {
    c = DriverManager.getConnection(jdbcUrl); vars.putObject('conn', c)
    def reg = props.get('gg9.conns')
    if (reg == null) { props.putIfAbsent('gg9.conns', new java.util.concurrent.ConcurrentLinkedQueue()); reg = props.get('gg9.conns') }
    reg.add(c)
  }
  return c
}
def discardConn = { def c = vars.getObject('conn'); vars.putObject('conn', null); try { c?.close() } catch (Throwable ignored) { }
  try { props.get('gg9.conns')?.remove(c) } catch (Throwable ignored) { } }
def release = { c -&gt; }
try {
def c = getConn()
def ps = c.prepareStatement('''SELECT id, customer_id, balance, status, payload FROM accounts WHERE id = ?''')
try {
    ps.setLong(1, Long.parseLong(vars.get('k')))
    int n = 0
    def rs = ps.executeQuery()
    try { while (rs.next()) { n++ } } finally { rs.close() }
    return 'rows ' + n
} finally { ps.close() }

} catch (Throwable t) {
  discardConn()
  throw t
}
</stringProp></JSR223Sampler><hashTree></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="oltp.update" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">

